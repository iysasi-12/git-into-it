# Copy to server/.env (or the repo root .env) and fill in.
AIVANA_API_KEY=your-aivana-api-key
AIVANA_BASE_URL=https://api.aivana.ai/v1
# true = canned AI responses (no network). Great for dev and as a demo safety net.
AIVANA_MOCK=true
# Parse and what-if (the user is waiting). Recommend and memo use the slow timeout.
AIVANA_TIMEOUT_MS=20000
AIVANA_SLOW_TIMEOUT_MS=45000
PORT=3001
